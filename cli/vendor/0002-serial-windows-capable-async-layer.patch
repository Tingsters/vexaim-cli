From 549771afefb1c9aeefbd73641fea5a8d362d64b8 Mon Sep 17 00:00:00 2001
From: Cassandra Chin <cassandra.chin@gmail.com>
Date: Sun, 18 Oct 2026 16:24:23 -0700
Subject: [PATCH 2/2] serial: make the async serial layer compile and run on
 Windows

async-serial 0.2.0 imports std::os::fd unconditionally, so the 'serial' feature does not build
on Windows, and async-io cannot poll COM ports. On Windows (or with the new 'blocking-io'
feature, so the code path can be exercised on any OS) drive a blocking serialport handle on a
thread pool via blocking::Unblock. Unix keeps async-serial unchanged.

Co-Authored-By: Claude Sonnet 5.5 <noreply@anthropic.com>
---
 packages/vex-v5-serial/Cargo.toml    |  8 ++-
 packages/vex-v5-serial/src/serial.rs | 94 ++++++++++++++++++++++++----
 2 files changed, 89 insertions(+), 13 deletions(-)

diff --git a/packages/vex-v5-serial/Cargo.toml b/packages/vex-v5-serial/Cargo.toml
index 4bd1a78..a0f4a95 100644
--- a/packages/vex-v5-serial/Cargo.toml
+++ b/packages/vex-v5-serial/Cargo.toml
@@ -16,7 +16,7 @@ log = "0.4"
 thiserror = "2"
 
 futures-util = { version = "0.3", features = ["io"], optional = true }
-async-serial = { version = "0.2.0", default-features = false, optional = true }
+blocking = { version = "1", optional = true }
 serialport = { version = "4.9.0", optional = true, features = [
     "usbportinfo-interface",
 ] }
@@ -26,14 +26,20 @@ uuid = { version = "1", default-features = false, optional = true }
 image = { version = "0.25.10", default-features = false, optional = true }
 flate2 = { version = "1.1.10", optional = true }
 
+[target.'cfg(not(windows))'.dependencies]
+async-serial = { version = "0.2.0", default-features = false, optional = true }
+
 [features]
 default = ["serial", "bluetooth"]
 serial = [
     "dep:futures-util",
     "dep:async-serial",
+    "dep:blocking",
     "dep:async-io",
     "dep:serialport",
 ]
+# Force the thread-based serial adapter that Windows uses (so it can be tested on other OSes).
+blocking-io = ["serial"]
 bluetooth = ["dep:futures-util", "dep:btleplug", "dep:uuid"]
 screen-commands = ["dep:image"]
 file-commands = ["dep:flate2"]
diff --git a/packages/vex-v5-serial/src/serial.rs b/packages/vex-v5-serial/src/serial.rs
index efea061..3693af0 100644
--- a/packages/vex-v5-serial/src/serial.rs
+++ b/packages/vex-v5-serial/src/serial.rs
@@ -1,6 +1,5 @@
 //! Implements discovering, opening, and interacting with vex devices connected over USB. This module does not have async support.
 
-use async_serial::{AsyncSerialPort, AsyncSerialPortBuilder};
 use futures_util::{AsyncReadExt, AsyncWriteExt, FutureExt, io::BufReader};
 use log::{debug, error, trace, warn};
 use std::time::Duration;
@@ -41,6 +40,86 @@ pub const AIV_USB_PID: u16 = 0x0800;
 
 pub const V5_SERIAL_BAUDRATE: u32 = 115200;
 
+/// Async serial port handle.
+///
+/// On Unix this is `async-serial`'s non-blocking TTY adapter. `async-serial` cannot compile on Windows
+/// (it imports `std::os::fd`), and `async-io` cannot poll COM ports, so on Windows (or with the `blocking-io`
+/// feature, which lets the same code be tested on any OS) a blocking `serialport` handle is driven on a
+/// thread pool through `blocking::Unblock`.
+#[cfg(not(any(windows, feature = "blocking-io")))]
+type AsyncSerialPort = async_serial::AsyncSerialPort;
+#[cfg(any(windows, feature = "blocking-io"))]
+type AsyncSerialPort = split::SplitPort;
+
+/// Thread-pool adapter used where `async-serial` is unavailable.
+///
+/// Reads and writes use separate clones of the port handle. A single `blocking::Unblock` reads ahead in the
+/// background; when that read hits the port's timeout, the error would otherwise be reported by the *next write*.
+#[cfg(any(windows, feature = "blocking-io"))]
+mod split {
+    use blocking::Unblock;
+    use futures_util::io::{AsyncRead, AsyncWrite};
+    use std::{
+        io,
+        pin::Pin,
+        task::{Context, Poll},
+    };
+
+    #[derive(Debug)]
+    pub struct SplitPort {
+        read: Unblock<Box<dyn serialport::SerialPort>>,
+        write: Unblock<Box<dyn serialport::SerialPort>>,
+    }
+
+    impl SplitPort {
+        pub fn new(port: Box<dyn serialport::SerialPort>) -> serialport::Result<Self> {
+            let write = port.try_clone()?;
+            Ok(Self {
+                read: Unblock::new(port),
+                write: Unblock::new(write),
+            })
+        }
+    }
+
+    impl AsyncRead for SplitPort {
+        fn poll_read(mut self: Pin<&mut Self>, cx: &mut Context<'_>, buf: &mut [u8]) -> Poll<io::Result<usize>> {
+            Pin::new(&mut self.read).poll_read(cx, buf)
+        }
+    }
+
+    impl AsyncWrite for SplitPort {
+        fn poll_write(mut self: Pin<&mut Self>, cx: &mut Context<'_>, buf: &[u8]) -> Poll<io::Result<usize>> {
+            Pin::new(&mut self.write).poll_write(cx, buf)
+        }
+        fn poll_flush(mut self: Pin<&mut Self>, cx: &mut Context<'_>) -> Poll<io::Result<()>> {
+            Pin::new(&mut self.write).poll_flush(cx)
+        }
+        fn poll_close(mut self: Pin<&mut Self>, cx: &mut Context<'_>) -> Poll<io::Result<()>> {
+            Pin::new(&mut self.write).poll_close(cx)
+        }
+    }
+}
+
+#[cfg(not(any(windows, feature = "blocking-io")))]
+fn open_port(name: &str, timeout: Duration) -> Result<AsyncSerialPort, SerialError> {
+    use async_serial::AsyncSerialPortBuilder;
+    Ok(async_serial::new(name, V5_SERIAL_BAUDRATE)
+        .timeout(timeout)
+        .parity(serialport::Parity::None)
+        .stop_bits(serialport::StopBits::One)
+        .open_async()?)
+}
+
+#[cfg(any(windows, feature = "blocking-io"))]
+fn open_port(name: &str, timeout: Duration) -> Result<AsyncSerialPort, SerialError> {
+    let port = serialport::new(name, V5_SERIAL_BAUDRATE)
+        .timeout(timeout)
+        .parity(serialport::Parity::None)
+        .stop_bits(serialport::StopBits::One)
+        .open()?;
+    Ok(split::SplitPort::new(port)?)
+}
+
 /// The information of a generic vex serial port
 #[derive(Clone, Debug)]
 pub struct VexSerialPort {
@@ -353,21 +432,12 @@ impl SerialConnection {
     pub fn open(device: SerialDevice, timeout: Duration) -> Result<Self, SerialError> {
         Ok(Self {
             system_port: {
-                let stream =
-                    async_serial::new(&device.system_port.port_info.port_name, V5_SERIAL_BAUDRATE)
-                        .timeout(timeout)
-                        .parity(serialport::Parity::None)
-                        .stop_bits(serialport::StopBits::One)
-                        .open_async()?;
+                let stream = open_port(&device.system_port.port_info.port_name, timeout)?;
 
                 (device.system_port, stream)
             },
             user_port: if let Some(port) = device.user_port {
-                let stream = async_serial::new(&port.port_info.port_name, V5_SERIAL_BAUDRATE)
-                    .timeout(timeout)
-                    .parity(serialport::Parity::None)
-                    .stop_bits(serialport::StopBits::One)
-                    .open_async()?;
+                let stream = open_port(&port.port_info.port_name, timeout)?;
 
                 Some((port, BufReader::new(stream)))
             } else {
